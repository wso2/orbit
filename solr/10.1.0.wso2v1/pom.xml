<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <packaging>bundle</packaging>
    <groupId>org.wso2.orbit.org.apache.solr</groupId>
    <artifactId>solr</artifactId>
    <version>${orbit.version.solr}</version>
    <name>solr.wso2</name>
    <description>
        This bundle will represent solr and lucene jars for Solr 10.
    </description>

    <!--
        Only the Solr artifacts are declared directly. Everything else is resolved transitively from Solr and
        embedded through Embed-Transitive. Pin a transitive dependency here only when the version Solr brings
        is outdated.
    -->
    <dependencyManagement>
        <dependencies>
            <!-- Jetty: newer than the version Solr brings -->
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-client</artifactId>
                <version>${jetty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-http</artifactId>
                <version>${jetty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-util</artifactId>
                <version>${jetty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-io</artifactId>
                <version>${jetty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-alpn-client</artifactId>
                <version>${jetty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty.http2</groupId>
                <artifactId>jetty-http2-client</artifactId>
                <version>${jetty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty.http2</groupId>
                <artifactId>jetty-http2-client-transport</artifactId>
                <version>${jetty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty.http2</groupId>
                <artifactId>jetty-http2-common</artifactId>
                <version>${jetty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty.http2</groupId>
                <artifactId>jetty-http2-hpack</artifactId>
                <version>${jetty.version}</version>
            </dependency>

            <!-- OpenTelemetry: newer than the version Solr brings -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-api</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-context</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-sdk</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-sdk-metrics</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-sdk-trace</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-exporter-prometheus</artifactId>
                <version>${opentelemetry.exporter.prometheus.version}</version>
            </dependency>

            <!-- ZooKeeper: newer than the version Solr brings -->
            <dependency>
                <groupId>org.apache.zookeeper</groupId>
                <artifactId>zookeeper</artifactId>
                <version>${version.zookeeper}</version>
                <exclusions>
                    <exclusion>
                        <groupId>ch.qos.logback</groupId>
                        <artifactId>logback-classic</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>ch.qos.logback</groupId>
                        <artifactId>logback-core</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.apache.zookeeper</groupId>
                <artifactId>zookeeper-jute</artifactId>
                <version>${version.zookeeper}</version>
            </dependency>

            <!-- HK2 locator: Jersey brings a milestone (4.0.0-M3) -->
            <dependency>
                <groupId>org.glassfish.hk2</groupId>
                <artifactId>hk2-locator</artifactId>
                <version>${hk2.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Solr Core -->
        <dependency>
            <groupId>org.apache.solr</groupId>
            <artifactId>solr-core</artifactId>
            <version>${version.solr}</version>
            <optional>true</optional>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j2-impl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>commons-codec</groupId>
                    <artifactId>commons-codec</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>commons-io</groupId>
                    <artifactId>commons-io</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Solr SolrJ -->
        <dependency>
            <groupId>org.apache.solr</groupId>
            <artifactId>solr-solrj</artifactId>
            <version>${version.solr}</version>
            <optional>true</optional>
            <exclusions>
                <exclusion>
                    <groupId>commons-codec</groupId>
                    <artifactId>commons-codec</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>commons-io</groupId>
                    <artifactId>commons-io</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Solr SolrJ ZooKeeper -->
        <dependency>
            <groupId>org.apache.solr</groupId>
            <artifactId>solr-solrj-zookeeper</artifactId>
            <version>${version.solr}</version>
            <optional>true</optional>
        </dependency>

        <!-- Solr SolrJ Streaming -->
        <dependency>
            <groupId>org.apache.solr</groupId>
            <artifactId>solr-solrj-streaming</artifactId>
            <version>${version.solr}</version>
            <optional>true</optional>
        </dependency>

        <!-- Solr Scripting (XSLTResponseWriter referenced by registry-indexing solrconfig.xml) -->
        <dependency>
            <groupId>org.apache.solr</groupId>
            <artifactId>solr-scripting</artifactId>
            <version>${version.solr}</version>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <distributionManagement>
        <repository>
            <id>wso2.releases</id>
            <name>WSO2 internal Repository</name>
            <url>https://maven.wso2.org/nexus/content/repositories/releases/</url>
        </repository>
    </distributionManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <version>${maven.bundle.plugin.version}</version>
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>${project.artifactId}</Bundle-SymbolicName>
                        <Bundle-Name>${project.artifactId}</Bundle-Name>
                        <Export-Package>
                            org.apache.solr.*;version="${version.solr}",
                            org.apache.lucene.*;version="${version.lucene}";-split-package:=merge-first,
                            org.tartarus.snowball.*;version="${project.version}",
                            org.locationtech.spatial4j.*;version="${spatial4j.version}",
                        </Export-Package>
                        <Import-Package>
                            !org.apache.hadoop.*,
                            !org.apache.calcite.*,
                            !org.glassfish.jersey.*,
                            !org.glassfish.hk2.*,
                            !jakarta.ws.rs.*,
                            !jakarta.inject.*,
                            !jakarta.annotation.*,
                            !jakarta.validation.*,
                            !org.apache.solr.*,
                            !org.eclipse.jetty.*,
                            !org.apache.lucene.*,
                            !org.tartarus.snowball.*,
                            !org.locationtech.spatial4j.*,
                            !io.opentelemetry.*,
                            !io.opentelemetry.instrumentation.*,
                            !com.fasterxml.jackson.*,
                            !com.github.benmanes.caffeine.*,
                            !io.dropwizard.metrics.*,
                            !com.carrotsearch.hppc.*,
                            org.xml.sax.helpers;version="${sax.import.version}",
                            org.xml.sax;version="${sax.import.version}",
                            org.w3c.dom;version="${w3c.dom.import.version}",
                            javax.xml.transform.stream;version="${javax.xml.import.version}",
                            javax.xml.transform.dom;version="${javax.xml.import.version}",
                            javax.xml.transform;version="${javax.xml.import.version}",
                            javax.xml.parsers;version="${javax.xml.import.version}",
                            org.apache.commons.io.*;version="${commons.io.import.version.range}";resolution:=mandatory,
                            org.apache.commons.codec.*;version="${commons.codec.import.version.range}";resolution:=optional,
                            org.apache.commons.lang3.*;version="${commons.lang3.import.version.range}";resolution:=optional,
                            org.apache.commons.collections4.*;version="${commons.collections4.import.version.range}";resolution:=optional,
                            org.apache.zookeeper.*;version="${zookeeper.import.version.range}";resolution:=optional,
                            org.slf4j.*;version="${slf4j.import.version.range}",
                        </Import-Package>
                        <Private-Package>
                            io.opentelemetry.*,
                            io.opentelemetry.instrumentation.*,
                            io.opentelemetry.exporter.*,
                            io.opentelemetry.sdk.*,
                            io.opentelemetry.context.*,
                            org.glassfish.jersey.*,
                            org.glassfish.hk2.*,
                            jakarta.ws.rs.*,
                            jakarta.inject.*,
                            jakarta.annotation.*,
                            jakarta.validation.*,
                        </Private-Package>
                        <Embed-Dependency>
                            solr-core;scope=compile|runtime;inline=false,
                            solr-solrj;scope=compile|runtime;inline=false,
                            solr-solrj-zookeeper;scope=compile|runtime;inline=false,
                            solr-solrj-streaming;scope=compile|runtime;inline=false,
                            solr-scripting;scope=compile|runtime;inline=false,
                            lucene-core;scope=compile|runtime;inline=false,
                            lucene-analysis-common;scope=compile|runtime;inline=false,
                            lucene-queryparser;scope=compile|runtime;inline=false,
                            lucene-queries;scope=compile|runtime;inline=false,
                            lucene-highlighter;scope=compile|runtime;inline=false,
                            lucene-join;scope=compile|runtime;inline=false,
                            lucene-misc;scope=compile|runtime;inline=false,
                            lucene-codecs;scope=compile|runtime;inline=false,
                            lucene-memory;scope=compile|runtime;inline=false,
                            lucene-suggest;scope=compile|runtime;inline=false,
                            lucene-grouping;scope=compile|runtime;inline=false,
                            lucene-facet;scope=compile|runtime;inline=false,
                            lucene-backward-codecs;scope=compile|runtime;inline=false,
                            lucene-sandbox;scope=compile|runtime;inline=false,
                            lucene-spatial-extras;scope=compile|runtime;inline=false,
                            lucene-spatial3d;scope=compile|runtime;inline=false,
                            lucene-analysis-phonetic;scope=compile|runtime;inline=false,
                            jetty-client;scope=compile|runtime;inline=false,
                            jetty-http;scope=compile|runtime;inline=false,
                            jetty-util;scope=compile|runtime;inline=false,
                            jetty-io;scope=compile|runtime;inline=false,
                            jetty-alpn-client;scope=compile|runtime;inline=false,
                            jetty-http2-client;scope=compile|runtime;inline=false,
                            jetty-http2-client-transport;scope=compile|runtime;inline=false,
                            jetty-http2-common;scope=compile|runtime;inline=false,
                            jetty-http2-hpack;scope=compile|runtime;inline=false,
                            opentelemetry-api;scope=compile|runtime;inline=false,
                            opentelemetry-context;scope=compile|runtime;inline=false,
                            opentelemetry-sdk;scope=compile|runtime;inline=false,
                            opentelemetry-sdk-metrics;scope=compile|runtime;inline=false,
                            opentelemetry-sdk-trace;scope=compile|runtime;inline=false,
                            opentelemetry-runtime-telemetry;scope=compile|runtime;inline=false,
                            opentelemetry-exporter-prometheus;scope=compile|runtime;inline=false,
                            prometheus-metrics-model;scope=compile|runtime;inline=false,
                            prometheus-metrics-config;scope=compile|runtime;inline=false,
                            prometheus-metrics-exposition-textformats;scope=compile|runtime;inline=false,
                            metrics-core;scope=compile|runtime;inline=false,
                            zookeeper;scope=compile|runtime;inline=false,
                            zookeeper-jute;scope=compile|runtime;inline=false,
                            curator-framework;scope=compile|runtime;inline=false,
                            curator-client;scope=compile|runtime;inline=false,
                            caffeine;scope=compile|runtime;inline=false,
                            spatial4j;scope=compile|runtime;inline=false,
                            hppc;scope=compile|runtime;inline=false,
                            semver4j;scope=compile|runtime;inline=false,
                            jakarta.ws.rs-api;scope=compile|runtime;inline=false,
                            jakarta.servlet-api;scope=compile|runtime;inline=false,
                            jakarta.inject-api;scope=compile|runtime;inline=false,
                            jakarta.annotation-api;scope=compile|runtime;inline=false,
                            jersey-server;scope=compile|runtime;inline=false,
                            jersey-common;scope=compile|runtime;inline=false,
                            jersey-hk2;scope=compile|runtime;inline=false,
                            jersey-media-json-jackson;scope=compile|runtime;inline=false,
                            hk2-api;scope=compile|runtime;inline=false,
                            hk2-locator;scope=compile|runtime;inline=false,
                            hk2-utils;scope=compile|runtime;inline=false,
                            javassist;scope=compile|runtime;inline=false,
                            osgi-resource-locator;scope=compile|runtime;inline=false,
                        </Embed-Dependency>
                        <Embed-Transitive>true</Embed-Transitive>
                        <DynamicImport-Package>*</DynamicImport-Package>
                    </instructions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedGroupFilter>org.apache.lucene</shadedGroupFilter>
                            <createSourcesJar>false</createSourcesJar>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <promoteTransitiveDependencies>false</promoteTransitiveDependencies>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                                    <projectName>Apache Solr</projectName>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <properties>
        <version.solr>10.1.0</version.solr>
        <orbit.version.solr>${version.solr}.wso2v1</orbit.version.solr>

        <!-- Versions Solr brings; used only for the exported package versions -->
        <version.lucene>10.4.0</version.lucene>
        <spatial4j.version>0.8</spatial4j.version>

        <maven.bundle.plugin.version>5.1.9</maven.bundle.plugin.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Jetty 12.x for Solr 10 -->
        <jetty.version>12.0.39</jetty.version>

        <!-- OpenTelemetry (required compile-time dependency) -->
        <opentelemetry.version>1.67.0</opentelemetry.version>
        <opentelemetry.exporter.prometheus.version>1.67.0-alpha</opentelemetry.exporter.prometheus.version>

        <!-- ZooKeeper -->
        <version.zookeeper>3.9.6</version.zookeeper>

        <!-- HK2 -->
        <hk2.version>4.0.1</hk2.version>

        <!-- Import version ranges -->
        <sax.import.version>0.0.0</sax.import.version>
        <w3c.dom.import.version>0.0.0</w3c.dom.import.version>
        <javax.xml.import.version>0.0.0</javax.xml.import.version>
        <commons.io.import.version.range>[2.4.0,3.0.0)</commons.io.import.version.range>
        <commons.codec.import.version.range>[1.10.0,2.0.0)</commons.codec.import.version.range>
        <commons.lang3.import.version.range>[3.0.0,4.0.0)</commons.lang3.import.version.range>
        <commons.collections4.import.version.range>[4.0.0,5.0.0)</commons.collections4.import.version.range>
        <zookeeper.import.version.range>[3.9.0,4.0.0)</zookeeper.import.version.range>
        <slf4j.import.version.range>[1.7.0,3.0.0)</slf4j.import.version.range>
    </properties>
</project>
